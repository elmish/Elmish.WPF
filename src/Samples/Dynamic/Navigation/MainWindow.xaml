<Window x:Class="Navigation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Navigation"
        xmlns:vm="clr-namespace:Elmish.WPF.Samples.Navigation;assembly=Navigation.Core"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="450"
        Width="800">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Datei">
        <MenuItem Header="_Dashboard"
                  Command="{Binding Navigate}"
                  CommandParameter="{x:Static vm:Program+Main+Uri.Dashboard}" />
        <MenuItem Header="Kunden"
                  Command="{Binding Navigate}"
                  CommandParameter="{x:Static vm:Program+Main+Uri.Customer}" />
        <Separator />
        <MenuItem Header="B_eenden" />
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom" />
    <ContentControl>
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Setter Property="Content" Value="{Binding Dashboard}" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <local:DashboardView />
              </DataTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActivePageName}" Value="Customer">
              <Setter Property="Content" Value="{Binding Customer}" />
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <local:CustomerView />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
  </DockPanel>
</Window>